# ==============================================================================
# Capeonn Production Environment Configuration Template
# Copy to .env in your production environment and customize values
# ==============================================================================

APP_NAME="Capeonn Enterprise"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://api.capeonn.com
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logging Configuration (Rotate daily, keep 14 days)
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Production Database (MySQL 8.0)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=capeonn_prod
DB_USERNAME=capeonn_dbuser
DB_PASSWORD="STRONG_PRODUCTION_DB_PASSWORD"

# High-Performance Cache & Session (Redis recommended for cluster/scale, or database/file)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.capeonn.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=capeonn_cache_

# Production Redis (Optional if using Redis for cache/queues/sessions)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production Email Delivery (Postmark / Sendgrid / Amazon SES / SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=postmaster@capeonn.com
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@capeonn.com"
MAIL_FROM_NAME="Capeonn Notification Engine"

# Real-Time WebSocket Server (Laravel Reverb)
REVERB_APP_ID=capeonn-app
REVERB_APP_KEY=capeonn-production-key-928172
REVERB_APP_SECRET=capeonn-production-secret-918273645
REVERB_HOST=api.capeonn.com
REVERB_PORT=443
REVERB_SCHEME=https

# Push Notifications (Firebase Cloud Messaging / FCM v1)
FCM_PROJECT_ID=capeonn-enterprise
FCM_CREDENTIALS_PATH=storage/app/firebase-service-account.json

# Disaster Recovery & S3 Cloud Sync (Optional)
SYNC_OFFSITE=false
S3_BUCKET_NAME=capeonn-production-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
